.PHONY: all build compile clean tidy format test vet list help cross-build ltrace install dump

MAIN_PATH  := ./cmd/wifisec
BUILD_PATH := build
APP_NAME   := wifisec

VERSION := $(shell git describe --tags --always 2>/dev/null || echo dev)
LDFLAGS := -X github.com/ctkqiang/wifisec/internal/constants.BuildVersion=$(VERSION)

C_RESET := \033[0m
C_CYAN  := \033[36m
C_GREEN := \033[32m
C_GRAY  := \033[90m

all: build

build:
	@start=$$(date +%s); \
	mkdir -p $(BUILD_PATH); \
	if [ "$$(uname -s)" = "Darwin" ]; then \
		rm -rf $(BUILD_PATH)/$(APP_NAME) $(BUILD_PATH)/$(APP_NAME).app; \
		mkdir -p $(BUILD_PATH)/$(APP_NAME).app/Contents/MacOS; \
		go build -ldflags "$(LDFLAGS)" -o $(BUILD_PATH)/$(APP_NAME).app/Contents/MacOS/$(APP_NAME) $(MAIN_PATH); \
		cp internal/platform/darwin/Info.plist $(BUILD_PATH)/$(APP_NAME).app/Contents/Info.plist; \
		codesign --sign - --force $(BUILD_PATH)/$(APP_NAME).app >/dev/null 2>&1 \
			&& printf "  $(C_CYAN)▸$(C_RESET) ad-hoc 签名完成\n" \
			|| printf "  $(C_GRAY)▸ codesign 失败，定位授权弹窗可能无法弹出$(C_RESET)\n"; \
		ln -s $(APP_NAME).app/Contents/MacOS/$(APP_NAME) $(BUILD_PATH)/$(APP_NAME); \
		out="$(BUILD_PATH)/$(APP_NAME).app"; \
	else \
		go build -ldflags "$(LDFLAGS)" -o $(BUILD_PATH)/$(APP_NAME) $(MAIN_PATH); \
		out="$(BUILD_PATH)/$(APP_NAME)"; \
	fi; \
	size=$$(wc -c < "$(BUILD_PATH)/$(APP_NAME)" 2>/dev/null | tr -d ' '); \
	elapsed=$$(( $$(date +%s) - start )); \
	printf "  $(C_GREEN)✓$(C_RESET) %s  $(C_GRAY)%s · %s bytes · %ds$(C_RESET)\n" "$$out" "$(VERSION)" "$$size" "$$elapsed"

compile:
	@mkdir -p $(BUILD_PATH)
	@go build -gcflags="-S" -ldflags "$(LDFLAGS)" -o /dev/null $(MAIN_PATH) 2>&1 \
		| grep -v '<autogenerated>' | sed -E 's/\([^)]*\.go:[0-9]+\)//g' > $(BUILD_PATH)/$(APP_NAME).s
	@lines=$$(wc -l < $(BUILD_PATH)/$(APP_NAME).s | tr -d ' '); \
	printf "  $(C_GREEN)✓$(C_RESET) %s  $(C_GRAY)%s lines$(C_RESET)\n" "$(BUILD_PATH)/$(APP_NAME).s" "$$lines"

clean:
	@rm -rf $(BUILD_PATH) $(APP_NAME)
	@printf "  $(C_GREEN)✓$(C_RESET) build/ cleaned\n"

tidy:
	go mod tidy
	@printf "  $(C_GREEN)✓$(C_RESET) go mod tidy\n"

format:
	go fmt ./...
	@printf "  $(C_GREEN)✓$(C_RESET) go fmt ./...\n"

test:
	go test -race -count=1 ./...

vet:
	go vet ./...
	@printf "  $(C_GREEN)✓$(C_RESET) go vet ./...\n"

run:
	go run -race $(MAIN_PATH)

list:
	go run -race $(MAIN_PATH) list $(TARGET)

help:
	go run -race $(MAIN_PATH) help

install:
	go install -ldflags "$(LDFLAGS)" $(MAIN_PATH)
	@printf "  $(C_GREEN)✓$(C_RESET) installed %s ($(VERSION))\n" "$(APP_NAME)"

cross-build:
	@mkdir -p $(BUILD_PATH)
	@start=$$(date +%s); count=0; \
	host_arch="$$(uname -m)"; \
	for target in \
		"linux/amd64:$(APP_NAME)-linux-amd64" \
		"linux/arm64:$(APP_NAME)-linux-arm64" \
		"windows/amd64:$(APP_NAME)-windows-amd64.exe" \
		"darwin/arm64:$(APP_NAME)-darwin-arm64" \
		"darwin/amd64:$(APP_NAME)-darwin-amd64"; \
	do \
		os="$${target%%/*}"; arch="$${target#*/}"; arch="$${arch%%:*}"; out="$${target##*:}"; \
		if [ "$$os" = "darwin" ] && [ "$$arch" != "$$host_arch" ]; then \
			printf "  $(C_GRAY)· %s/%s skipped（非宿主架构，需交叉 cgo 工具链）$(C_RESET)\n" "$$os" "$$arch"; \
			continue; \
		fi; \
		printf "  $(C_CYAN)▸$(C_RESET) %s/%s\n" "$$os" "$$arch"; \
		GOOS="$$os" GOARCH="$$arch" go build -ldflags "$(LDFLAGS)" -o $(BUILD_PATH)/"$$out" $(MAIN_PATH); \
		count=$$((count + 1)); \
	done; \
	elapsed=$$(( $$(date +%s) - start )); \
	printf "  $(C_GREEN)✓$(C_RESET) %d binaries  $(C_GRAY)%ds$(C_RESET)\n" "$$count" "$$elapsed"

ltrace:
	@mkdir -p $(BUILD_PATH)/trace
	@for pkg in $$(go list ./...); do \
		name=$$(echo "$$pkg" | tr '/' '_'); \
		go test -trace $(BUILD_PATH)/trace/$$name.out "$$pkg" >/dev/null 2>&1 \
			&& printf "  $(C_GREEN)✓$(C_RESET) %s\n" "$$pkg" \
			|| printf "  $(C_GRAY)· %s（无测试或已跳过）$(C_RESET)\n" "$$pkg"; \
	done
	@printf "  $(C_GRAY)trace 文件输出至 %s/trace/$(C_RESET)\n" "$(BUILD_PATH)"

dump:
	objdump -d $(BUILD_PATH)/wifisec >> $(BUILD_PATH)/objdump.s
	@printf "  $(C_GREEN)✓$(C_RESET) objdump.s generated\n in "$(BUILD_PATH)/objdump.s"
